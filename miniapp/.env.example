# Mini App uchun build-time o'zgaruvchilar.
# Bu qiymatlar bundle ichiga tushadi — SIR YOZILMAYDI (CLAUDE.md §1.2).

# Backend manzili (oxirida / bo'lmasin)
VITE_API_BASE_URL=http://localhost:8080

# Bot username — kanal va bot havolalari uchun
VITE_BOT_USERNAME=uzb_jp_elon_bot

# --- Faqat lokal sinov ---
# Telegram tashqarisida UI'ni sinash uchun tayyor initData.
# scripts/dev-initdata.py yasab beradi. .env.local ga yoziladi, commit qilinmaydi.
# Faqat `npm run dev` da ishlaydi — prod build'da bu kod yo'q.
VITE_DEV_INIT_DATA=
