# =====================================================================
# .env.example — bu fayl git'da turadi, REAL QIYMATLAR bilan emas.
# Ishlatish: `cp .env.example .env` va qiymatlarni to'ldiring.
# `.env` .gitignore'da — hech qachon commit qilinmaydi (§1.2).
# =====================================================================

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=uzb_jp_elon_bot
CHANNEL_CHAT_ID=-1001424117981
CHANNEL_USERNAME=jpuzbpochta
MINIAPP_URL=https://app.example.com
# Mini App build vaqtida backend manzili (bundle ichiga tushadi)
MINIAPP_API_BASE_URL=http://localhost:8080
MINIAPP_PORT=5173
# polling (dev, long polling) | webhook (prod) | off (bot ishga tushmaydi)
BOT_MODE=polling
WEBHOOK_BASE_URL=https://api.example.com
# Tasodifiy uzun satr. Webhook URL segmentida ham, secret_token headerida ham ishlatiladi.
WEBHOOK_SECRET_TOKEN=

# --- DB ---
DB_URL=jdbc:postgresql://localhost:5432/pochta
DB_USERNAME=pochta
DB_PASSWORD=

# --- Admin (4-bosqich) ---
# Tasodifiy uzun satr. Bo'sh bo'lsa admin API butunlay yopiq turadi.
ADMIN_JWT_SECRET=
# Bu telegram_id'lar birinchi kirishda avtomatik ADMIN rolini oladi (§11.1)
ADMIN_TELEGRAM_IDS=123456789,987654321
# CORS uchun ruxsat berilgan admin domeni (§7.2)
ADMIN_URL=https://admin.example.com
# Admin build vaqtida backend manzili (bundle ichiga tushadi)
ADMIN_API_BASE_URL=http://localhost:8080
ADMIN_PORT=5174

# --- Boshqa ---
SPRING_PROFILES_ACTIVE=dev
INITDATA_MAX_AGE_SECONDS=86400
RATE_LIMIT_POSTS_PER_DAY=5
RATE_LIMIT_REQUESTS_PER_MINUTE=60
SERVER_PORT=8080
LOG_LEVEL_APP=INFO

# --- docker-compose (postgres konteyner uchun) ---
POSTGRES_DB=pochta
POSTGRES_USER=pochta
POSTGRES_PASSWORD=
